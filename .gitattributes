# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Source code and config files
*.dart text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.lock text eol=lf

# Explicit lockfiles
frontend/pubspec.lock text eol=lf
backend/package-lock.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

